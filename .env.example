# Copy to .env / .env.local and fill in local values. Never commit real secrets.

# apps/web (browser-visible)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/web (server-side): base URL of the NestJS API
API_URL=http://127.0.0.1:3001

# apps/api
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
OPENAPI_ENABLED=true
BODY_LIMIT_KB=100
JSON_DEPTH_LIMIT=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_PER_MIN=60
RATE_LIMIT_ANON_PER_MIN=20
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_ANONYMOUS=20
LOG_LEVEL=info

# Test-only privileged SQL URL, printed by `supabase status -o env` as DB_URL.
# Runtime application code does not use a direct database connection.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
