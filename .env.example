# Copy to .env / .env.local and fill in local values. Never commit real secrets.

# apps/web (browser-visible)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/web (server-side): base URL of the NestJS API
API_URL=http://127.0.0.1:3001

# apps/api
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_SECRET=
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
OPENAPI_ENABLED=true
RATE_LIMIT_AUTHENTICATED=60
RATE_LIMIT_ANONYMOUS=20
LOG_LEVEL=info

# Local Postgres.app (Task 2 fallback; no real Supabase Auth on dev host)
# Used by apps/api/test/helpers/db.ts and the db:seed / db:reset scripts.
# Replace <os-user> with your macOS username (or `whoami`).
DATABASE_URL=postgresql:///continuous_security_demo?host=/tmp&user=<os-user>
