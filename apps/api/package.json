{
  "name": "@continuous-security-demo/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/main.js",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathIgnorePatterns=/test/",
    "test:rls": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config test/jest-rls.json",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test/sql/000_auth_stub.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f test/sql/003_seed.sql",
    "db:reset": "npm run db:seed -w @continuous-security-demo/api"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@supabase/supabase-js": "2.112.4",
    "jose": "6.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "jest": "30.5.0",
    "oxlint": "^1.58.0",
    "pg": "8.23.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "7.0.2"
  }
}
